//@version=6
strategy('6 ES1! Long 1D MA200 MA5', overlay = true, initial_capital = 5000, default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 999, commission_value = 0, commission_type = strategy.commission.percent, slippage = 2)

// Cálculos de las medias móviles
ma200 = ta.sma(close, 200)
ma5   = ta.sma(close, 5)

// Condiciones para entrada LONG (opposite of short vector)
isMa200Uptrending = ma200[1] < ma200
isBearishCandle   = close < open
isBelowMa5        = high < ma5

isLong = isMa200Uptrending and isBearishCandle and isBelowMa5

// Entrada en largo si se cumplen las condiciones y la dirección permitida
if isLong
    strategy.entry('LONG', strategy.long)

// Cerrar posición larga cuando el precio cierre por encima de MA5
if strategy.position_size > 0 and close > ma5
    strategy.close('LONG')
